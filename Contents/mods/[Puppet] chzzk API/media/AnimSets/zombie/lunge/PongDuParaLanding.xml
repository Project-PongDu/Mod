		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>
	<m_Conditions>
		<m_Name>PongDuParaLanding</m_Name>
		<m_Type>BOOL</m_Type>
