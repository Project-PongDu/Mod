<?xml version="1.0" encoding="utf-8"?>
<!-- PongDu: event donor for lua/client/PongDuRangedShotFix.lua. Never plays.
     It has no m_AnimName and no 2D blends, so AnimNode.isAbstract() is true and AnimState never
     selects it; the condition below is a second guard (the variable is never set).
     The Lua fix copies these two Start time events into every loaded ranged node whose
     AttackCollisionCheck sits at TimePc 0.01 or earlier, so the shot connects even when a long frame
     plays the whole fast fire clip in one update. AnimEvent cannot be created from Lua, which is why
     the events live in this file. Keep SetVariable first: Start events run in list order and the hit
     reaction must be set before the collision check. -->
<animNode>
	<m_Name>PongDuShotEventDonor</m_Name>
	<m_Conditions>
		<m_Name>PongDuShotEventDonor</m_Name>
		<m_Type>BOOL</m_Type>
		<m_BoolValue>true</m_BoolValue>
	</m_Conditions>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>ZombieHitReaction=Shot</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>AttackCollisionCheck</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
</animNode>
